# Relay — Environment Configuration
# Copy this file to .env and fill in your values. .env is gitignored.

# Runtime mode
RELAY_ENV=development

# CORS allowlist, comma-separated
RELAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Basic abuse limits
RELAY_RATE_LIMIT_REQUESTS=120
RELAY_RATE_LIMIT_WINDOW_SECONDS=60
RELAY_MAX_BODY_BYTES=1048576

# Human owner identity
RELAY_HUMAN_ID=human
RELAY_HUMAN_NAME=Human
RELAY_HUMAN_KEY=your-human-api-key

# Agents — add as many as needed (increment the number)
RELAY_AGENT_1_ID=agent1
RELAY_AGENT_1_NAME=Agent One
RELAY_AGENT_1_AVATAR=🤖
RELAY_AGENT_1_ROLE=Worker
RELAY_AGENT_1_MODEL=openai/gpt-4o
RELAY_AGENT_1_PROVIDER=openai
RELAY_AGENT_1_KEY=your-agent1-api-key

RELAY_AGENT_2_ID=agent2
RELAY_AGENT_2_NAME=Agent Two
RELAY_AGENT_2_AVATAR=🤖
RELAY_AGENT_2_ROLE=Reviewer
RELAY_AGENT_2_MODEL=anthropic/claude-3-5-sonnet
RELAY_AGENT_2_PROVIDER=anthropic
RELAY_AGENT_2_KEY=your-agent2-api-key
